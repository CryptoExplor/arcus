# Arcus testnet volume bot — copy to .env and fill in.
# Generate credentials at https://testnet.arcus.xyz/api-keys or via tools/onboard.py

# ---- identity -------------------------------------------------------------
ARCUS_NETWORK=testnet          # testnet | mainnet  (live+mainnet is refused)
ARCUS_VENUE=arcus              # arcus | sim  (sim = offline paper exchange)
ARCUS_ADDRESS=                 # 0x… master wallet address
ARCUS_API_SECRET=              # Ed25519 API signing key, 64 hex chars — SECRET
ARCUS_ACCOUNT_INDEX=0
# ARCUS_REST_URL=              # override endpoints if needed
# ARCUS_WS_URL=

# ---- behaviour ------------------------------------------------------------
BOT_MODE=dry-run               # dry-run | live
BOT_STRATEGY=volume-maker      # volume-maker | ping-pong | spot-rfq
BOT_MARKETS=BTC-USD,ETH-USD
BOT_ORDER_NOTIONAL_USD=25      # per clip; exchange minimum is $5
BOT_QUOTE_LEVELS=1
BOT_LEVEL_STEP_BPS=4
BOT_LEVERAGE=3
BOT_AGGRESSIVE=true            # testnet: tighter/faster within the fee floor
BOT_ENABLE_SPOT=false
BOT_SPOT_MARKETS=AAPL,TSLA

# ---- edge and quoting -----------------------------------------------------
BOT_SPREAD_BPS=10              # target round-trip edge — see docs/STRATEGY.md
BOT_MIN_EDGE_BPS=0            # extra floor on top of the fee-derived edge
BOT_FEE_BUFFER_BPS=1           # required margin above round-trip fees
BOT_VOL_EDGE_MULTIPLIER=1.5    # widen per bps of realised volatility
BOT_INVENTORY_SKEW_BPS=8
BOT_JOIN_BBO=true
BOT_REQUOTE_BPS=2
BOT_REQUOTE_INTERVAL_S=1.5
BOT_MAX_QUOTE_AGE_S=20         # stale quote  -> re-quote
BOT_INVENTORY_MAX_AGE_S=90     # stale inventory -> cross the spread to flatten
BOT_TAKER_SLIPPAGE_BPS=25      # protective bound on IOC closes (<10% of mark)
BOT_FLATTEN_TIF=IOC

# ---- risk -----------------------------------------------------------------
BOT_MAX_POSITION_NOTIONAL_USD=150
BOT_MAX_INVENTORY_NOTIONAL_USD=75
RISK_MAX_DRAWDOWN_USD=25
RISK_MAX_DAILY_LOSS_USD=40
RISK_MIN_FREE_COLLATERAL_USD=50
RISK_MAX_OPEN_ORDERS=12
RISK_MAX_ORDERS_PER_MIN=90
RISK_MAX_CONSECUTIVE_ERRORS=12
RISK_STALE_PRICE_S=20
RISK_CANCEL_ALL_ON_EXIT=true
RISK_DEAD_MANS_SWITCH_S=0      # >0 arms the venue-side cancel-all switch

# ---- session limits (set at least one for unattended runs) ----------------
BOT_VOLUME_TARGET_USD=0        # 0 = unlimited
BOT_MAX_RUNTIME_S=0            # 0 = unlimited

# ---- runtime / observability ----------------------------------------------
BOT_LOOP_INTERVAL_S=1.0
BOT_REPORT_INTERVAL_S=30
BOT_METRICS_HOST=0.0.0.0
BOT_METRICS_PORT=0             # 0 = dashboard off
BOT_LOG_LEVEL=INFO
BOT_LOG_DIR=logs
BOT_STATE_DIR=state
BOT_PRINT_SUMMARY=true
BOT_RECONNECT_MAX_S=30

# ---- simulator (ARCUS_VENUE=sim only) -------------------------------------
SIM_SEED=7
SIM_SPEED=1                    # wall-clock acceleration
SIM_VOL_BPS=6                  # per-second volatility
SIM_UNINFORMED_RATE=0.25       # share of non-toxic flow; 0 = pure adverse selection
SIM_MAKER_FILL_PROB=0.85
SIM_LATENCY_MS=40
