# =============================================================================
#  Arcus testnet volume bot — TEMPLATE. Copy to .env and fill in.
# =============================================================================
#  Copy:  cp .env.example .env    (.env is gitignored; this template is not)
#  Never put real secrets in THIS file — put them in .env.
#
#  Quick start:
#    1. Fill in ARCUS_ADDRESS and ARCUS_API_SECRET below.
#    2. .venv/bin/python -m arcusbot preflight
#    3. .venv/bin/python -m arcusbot run --mode dry-run --port 8080
#    4. Only when dry-run looks right:  --mode live
# =============================================================================

# ---- identity ---------------------------------------------------------------
ARCUS_NETWORK=testnet          # testnet | mainnet   (mainnet live needs the gate below)
ARCUS_VENUE=sim                # sim = offline paper exchange (no keys needed)
                               # switch to `arcus` to use the real API

# Your master wallet address (0x…, 42 chars).
ARCUS_ADDRESS=

# Ed25519 API SIGNING KEY — 64 hex chars. THIS IS A SECRET.
#   Get one at https://testnet.arcus.xyz/api-keys (shown exactly once),
#   or run: .venv/bin/python tools/onboard.py --private-key 0x<wallet key>
#   It authorizes TRADING ONLY — it cannot withdraw funds.
#
#   NOTE: this is NOT your wallet private key. Never put a wallet private key
#   in this file. The only tools that need one take it as a --private-key
#   argument, use it locally to sign a single message, and never store it.
ARCUS_API_SECRET=

ARCUS_ACCOUNT_INDEX=0          # subaccount; each has its own rate-limit pools

# =============================================================================
#  NAMED WALLET PROFILES (optional) — several wallets in one file
# =============================================================================
#  Switch between them with --wallet <name>, e.g.:
#      python -m arcusbot preflight --wallet t1
#      python -m arcusbot run --wallet t2 --mode live
#      python -m arcusbot wallets              # list everything defined here
#
#  The suffix is the profile name, UPPER-CASED. The unsuffixed keys above stay
#  the "default" profile. Network is inferred from the name (t*/test* ->
#  testnet, m*/main* -> mainnet) unless you set ARCUS_NETWORK_<NAME>.

# ---- testnet wallet 1 --------------------------------------------------------
ARCUS_ADDRESS_T1=
ARCUS_API_SECRET_T1=
ARCUS_NETWORK_T1=testnet
ARCUS_LABEL_T1=testnet wallet 1

# ---- testnet wallet 2 --------------------------------------------------------
ARCUS_ADDRESS_T2=
ARCUS_API_SECRET_T2=
ARCUS_NETWORK_T2=testnet
ARCUS_LABEL_T2=testnet wallet 2

# ---- mainnet wallet 1 (REAL MONEY) ------------------------------------------
#  Trading from this still requires the mainnet gate (BOT_MAINNET_* below).
ARCUS_ADDRESS_M1=
ARCUS_API_SECRET_M1=
ARCUS_NETWORK_M1=mainnet
ARCUS_LABEL_M1=mainnet wallet 1

# ---- WALLET PRIVATE KEYS — read this before using ---------------------------
#  DANGER. A wallet private key can WITHDRAW YOUR FUNDS. The API signing keys
#  above authorise TRADING ONLY and are all the bot needs to run. You only need
#  a wallet key to register a new API key (tools/onboard.py) or to sign a spot
#  RFQ intent.
#
#  Preferred: leave these blank and pass the key as a one-off argument:
#      python tools/onboard.py --private-key 0x...
#
#  If you do store them, they are never loaded during ordinary trading — only
#  when a tool explicitly asks for one — and a MAINNET key additionally
#  requires ARCUS_ALLOW_MAINNET_PRIVATE_KEY=true below.
# ARCUS_PRIVATE_KEY_T1=
# ARCUS_PRIVATE_KEY_T2=
# ARCUS_PRIVATE_KEY_M1=
# ARCUS_ALLOW_MAINNET_PRIVATE_KEY=false

# ---- mode -------------------------------------------------------------------
BOT_MODE=dry-run               # dry-run signs nothing | live sends real orders
BOT_STRATEGY=volume-maker      # volume-maker | ping-pong | spot-rfq
BOT_MARKETS=BTC-USD,ETH-USD

# =============================================================================
#  CAPITAL MANAGEMENT — how much of your balance the bot may use
# =============================================================================
#  Two ways to size. Pick ONE.
#
#  (A) FIXED — you set the dollar amounts yourself. Predictable, but it ignores
#      your balance: $25 clips mean something very different on a $100 account
#      than on a $100,000 one. This is the default.
#
#  (B) CAPITAL — set BOT_CAPITAL_USD or BOT_CAPITAL_PCT and every sizing knob
#      is derived from your equity, re-scaling as the account grows or shrinks:
#
#        deployable      = min(budget, equity − reserve)
#        exposure_budget = deployable × leverage × utilisation
#        per_market      = exposure_budget ÷ number_of_markets
#        clip            = per_market ÷ BOT_CAPITAL_CLIPS
#
#      Run `preflight` to see the exact plan before committing to it.
# -----------------------------------------------------------------------------

# --- (B) capital mode: set ONE of these to a non-zero value to enable ---------
BOT_CAPITAL_USD=0              # absolute budget, e.g. 500  (0 = off)
BOT_CAPITAL_PCT=0              # or a % of equity, e.g. 25  (0 = off)
                               # if both are set, the LOWER one wins

BOT_RESERVE_USD=0              # equity the bot must NEVER touch. This is your
                               # floor: it is also enforced as the minimum free
                               # collateral, so the bot stops opening before it
                               # eats into the reserve.

BOT_CAPITAL_UTILISATION=0.5    # share of available leverage actually deployed.
                               # 1.0 = run at full margin = liquidation risk.
                               # 0.5 is the deliberate safety gap.
BOT_CAPITAL_CLIPS=3            # clips per market inside the position cap
BOT_CAPITAL_INVENTORY_FRACTION=0.5   # soft (flatten-only) cap ÷ hard cap
BOT_CAPITAL_RESIZE_PCT=20      # re-size after equity drifts this % (0 = never)

# --- (A) fixed mode: used when capital mode is off ---------------------------
BOT_ORDER_NOTIONAL_USD=25      # per clip; the venue minimum is $5
BOT_MAX_POSITION_NOTIONAL_USD=150   # hard cap per market
BOT_MAX_INVENTORY_NOTIONAL_USD=75   # soft cap -> stop opening, keep closing

BOT_LEVERAGE=3                 # set per market at startup

# =============================================================================
#  LOSS LIMITS — the kill switch
# =============================================================================
RISK_MAX_DRAWDOWN_USD=25       # halt after this peak-to-trough loss
RISK_MAX_DRAWDOWN_PCT=0        # …or as a % of deployed capital (overrides USD
                               # when >0 and capital mode is on). Scales with
                               # the account instead of going stale.
RISK_MAX_DAILY_LOSS_USD=40
RISK_MIN_FREE_COLLATERAL_USD=50     # below this: stop opening, keep closing
RISK_MAX_OPEN_ORDERS=12
RISK_MAX_ORDERS_PER_MIN=90
RISK_MAX_CONSECUTIVE_ERRORS=12
RISK_STALE_PRICE_S=20
RISK_CANCEL_ALL_ON_EXIT=true
RISK_DEAD_MANS_SWITCH_S=0      # >0 arms the venue-side cancel-all. Arcus has NO
                               # cancel-on-disconnect — set this for unattended runs.

# ---- state that survives restarts -------------------------------------------
#  Without this, every restart resets the drawdown baseline and the daily-loss
#  counter — a crash-looping bot could lose its whole limit again and again
#  while each individual session reported itself healthy.
BOT_PERSIST_STATE=true         # write state/session.json (false for CI/backtests)
RISK_CARRY_DRAWDOWN=true       # measure drawdown from the all-time peak
RISK_MAX_RESTART_CRASHES=0     # >0: refuse to start after N unclean exits in a
                               # row. A circuit breaker for crash loops.

# ---- session limits (set at least one for an unattended run) ----------------
BOT_VOLUME_TARGET_USD=0        # stop after this much volume (0 = unlimited)
BOT_MAX_RUNTIME_S=0            # stop after this many seconds (0 = unlimited)

# =============================================================================
#  EDGE — how wide to quote. See docs/STRATEGY.md before changing.
# =============================================================================
BOT_SPREAD_BPS=10              # target round-trip edge
BOT_MIN_EDGE_BPS=1             # absolute spread floor; survives rebate tiers
BOT_FEE_BUFFER_BPS=1           # required margin above round-trip fees
BOT_VOL_EDGE_MULTIPLIER=1.5    # widen per bps of realised volatility
BOT_INVENTORY_SKEW_BPS=8
BOT_JOIN_BBO=true
BOT_REQUOTE_BPS=2
BOT_REQUOTE_INTERVAL_S=1.5
BOT_MAX_QUOTE_AGE_S=20         # stale quote     -> re-quote
BOT_INVENTORY_MAX_AGE_S=90     # stale inventory -> cross the spread to flatten
BOT_TAKER_SLIPPAGE_BPS=25
BOT_FLATTEN_TIF=IOC
BOT_AGGRESSIVE=true

# ---- spot (Stock Tokens — zero fees, RFQ, needs a wallet signer) ------------
BOT_ENABLE_SPOT=false
BOT_SPOT_MARKETS=AAPL,TSLA

# =============================================================================
#  REFERRAL — attribution for signups made through this tool
# =============================================================================
#  Referral is a SIGNUP-time thing (a browser link), not an order field, so
#  these codes never touch your trades. Replace them with your own if you fork.
ARCUS_REFERRAL_TESTNET=ARCUS
ARCUS_REFERRAL_MAINNET=IN
BOT_SHOW_REFERRAL=true         # false hides the banner everywhere

# ---- runtime / observability ------------------------------------------------
BOT_LOOP_INTERVAL_S=1.0
BOT_REPORT_INTERVAL_S=30
BOT_METRICS_HOST=0.0.0.0
BOT_METRICS_PORT=0             # dashboard port; 0 = off, 8080 = on
BOT_LOG_LEVEL=INFO
BOT_LOG_DIR=logs
BOT_STATE_DIR=state
BOT_PRINT_SUMMARY=true
BOT_RECONNECT_MAX_S=30

# ---- mainnet gate (ALL required for live mainnet; see docs/BOT_OPERATIONS.md) ---
# Every one of these must be set, and set correctly, before the bot will trade
# real money. A malformed value denies the run — it never defaults to "on".
# BOT_MAINNET_ENABLED=false     # must be exactly true; 'ture'/'y'/'1.0' are refused
# BOT_MAINNET_CAPITAL_USD=      # hard cap on deployed capital, e.g. 20
# BOT_MAINNET_ACK=              # must be exactly: i-understand-the-risk
# BOT_MAINNET_MAX_CAPITAL_USD=100   # fat-finger ceiling for the above

# ---- simulator (only used when ARCUS_VENUE=sim) -----------------------------
SIM_SEED=7
SIM_SPEED=1
SIM_VOL_BPS=6
SIM_UNINFORMED_RATE=0.25       # share of non-toxic flow; 0 = pure adverse selection
SIM_MAKER_FILL_PROB=0.55
SIM_LATENCY_MS=25
